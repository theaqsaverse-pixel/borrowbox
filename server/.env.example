# Copy this file to ".env" (same folder) and fill in your own values.
# NEVER commit the real .env file.

PORT=5000

# postgresql://<user>:<password>@<host>:<port>/<database>
# The database is created for you by "npm run db:setup" if it does not exist yet.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/borrowbox

# Set to true only for hosted databases that require SSL (Neon, Render, Supabase ...)
DB_SSL=false

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Browser origin(s) allowed to call the API (comma separated)
CLIENT_URL=http://localhost:5173

# Optional: separate database used by "npm test" (defaults to <DATABASE_URL database>_test)
# TEST_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/borrowbox_test
